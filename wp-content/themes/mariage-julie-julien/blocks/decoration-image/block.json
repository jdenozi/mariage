{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "mariage/decoration-image",
    "version": "1.0.0",
    "title": "Image decorative",
    "category": "design",
    "icon": "format-image",
    "description": "Ajouter une image decorative positionnee librement sur la page",
    "keywords": ["decoration", "image", "fleur", "background", "fond"],
    "supports": {
        "html": false,
        "align": false
    },
    "textdomain": "mariage",
    "editorScript": "file:./index.js",
    "attributes": {
        "imageUrl": {
            "type": "string",
            "default": ""
        },
        "imageId": {
            "type": "number",
            "default": 0
        },
        "positionX": {
            "type": "number",
            "default": 10
        },
        "positionY": {
            "type": "number",
            "default": 10
        },
        "size": {
            "type": "number",
            "default": 15
        },
        "opacity": {
            "type": "number",
            "default": 100
        },
        "zIndex": {
            "type": "number",
            "default": 1
        },
        "hideOnMobile": {
            "type": "boolean",
            "default": false
        },
        "flipHorizontal": {
            "type": "boolean",
            "default": false
        }
    }
}
